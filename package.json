{
  "name": "ccreations-site",
  "private": true,
  "description": "Static site for CCreations. No build step; these dependencies are only for linting.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate index.html merk.html",
    "lint:css": "stylelint css/site.css",
    "lint:js": "eslint js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "html-validate": "^11.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
